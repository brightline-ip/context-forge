# Context Forge settings. Copy to a real environment (this file is not read automatically):
# set these in the shell or MCP client that launches the service. All are optional.

# Directory roots the service may read input files from (semicolon-separated absolute paths).
# Default: your Documents folder.
CONTEXT_FORGE_INPUT_ROOTS=C:\Users\YOU\Documents;D:\Matters

# Where normalized output is written. Default: <install dir>\output
CONTEXT_FORGE_OUTPUT_DIR=C:\Users\YOU\ContextForgeOutput

# Bearer token source. Use ONE of these, never both. Default: <install dir>\security\service-token.txt
# CONTEXT_FORGE_TOKEN_FILE=C:\Users\YOU\protected\context-forge-token.txt
# CONTEXT_FORGE_TOKEN=            # 43-256 URL-safe characters; for managed environments only

# Client settings (MCP server, CLI, PowerShell wrappers)
# CONTEXT_FORGE_URL=http://127.0.0.1:8765      # loopback HTTP only
# CONTEXT_FORGE_PYTHON=C:\path\to\python.exe   # default: <install dir>\.venv\Scripts\python.exe

# Optional Hermes plugin only (integrations/hermes-plugin): where the install lives
# CONTEXT_FORGE_HOME=C:\Tools\context-forge
